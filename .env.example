# Wellows API base URL (do not change for production)
WELLOWS_BASE_URL=https://wellows.com

# Port to listen on (Railway sets this automatically)
PORT=3000

# Public URL of this server (used in OAuth discovery)
SERVER_URL=https://your-app.railway.app

# OAuth — set a strong random secret in production
JWT_SECRET=change-me-in-production

# OAuth client ID that Claude.ai will present
OAUTH_CLIENT_ID=wellows-mcp-client

# Comma-separated allowed OAuth redirect URIs
OAUTH_REDIRECT_URIS=https://claude.ai/oauth/callback

# Public URL of your 512x512 PNG logo (used in connector directory listing)
LOGO_URL=https://wellows.com/logo-512.png
